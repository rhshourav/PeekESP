# Maintainer: rhshourav <rhshourav02@gmail.com>
pkgname=peekesp
pkgver=2.0.1
pkgrel=1
pkgdesc="Push this machine's CPU, RAM, storage, temperature, GPU and alerts to a PeekESP display"
arch=('any')
url="https://github.com/rhshourav/PeekESP"
license=('MIT')
# python only. The agent is standard library throughout - no psutil, no wheels,
# nothing to resolve - which is most of why this packages cleanly at all.
depends=('python' 'systemd')
optdepends=('lm_sensors: nothing is needed for temperature, /sys/class/thermal is enough'
            'nvidia-utils: GPU load, temperature and power on NVIDIA cards (nvidia-smi)')
backup=('etc/peekesp/agent.conf')
install="${pkgname}.install"
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')   # replaced by `updpkgsums` before submitting

package() {
  cd "PeekESP-${pkgver}"

  # /usr/lib, not /opt: /opt is for software installed outside the package
  # manager, and this is the package manager. The peekesp command checks for
  # the packaged path first, so one script serves both routes.
  install -Dm755 dietpi/peek-agent.py "${pkgdir}/usr/lib/${pkgname}/peek-agent.py"
  install -Dm755 dietpi/peekesp       "${pkgdir}/usr/bin/peekesp"

  install -Dm644 /dev/stdin "${pkgdir}/usr/lib/systemd/system/peek-agent.service" <<'UNIT'
[Unit]
Description=PeekESP telemetry agent
Documentation=https://github.com/rhshourav/PeekESP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/peekesp/agent.conf
ExecStart=/usr/bin/python3 /usr/lib/peekesp/peek-agent.py
Restart=always
RestartSec=10

User=peekesp
Group=peekesp

# The agent reads /proc and /sys, so it can give up essentially everything. The
# one thing it writes is its own state directory, below.
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
PrivateTmp=true

# The one place the service may write: the outbox of messages waiting for the
# phone, the history that "unusually high" is judged against, and the key for
# the local endpoint. systemd creates it, owned by the service account. Without
# this line the agent still runs, but keeps messages in memory only and leaves
# its local endpoint off - `peekesp status` says so.
StateDirectory=peekesp
StateDirectoryMode=0750

# ProtectHome is deliberately NOT set. It replaces /home with an empty mount,
# and this agent adds up every real filesystem to report storage - so a machine
# with /home on its own partition would silently stop counting it.

[Install]
WantedBy=multi-user.target
UNIT

  # Shipped empty of secrets. The pairing code is added by `peekesp pair`, and
  # a package that shipped one would put it in every user's filesystem.
  install -Dm600 /dev/stdin "${pkgdir}/etc/peekesp/agent.conf" <<'CONF'
# PeekESP agent configuration.  Edit with:  sudo peekesp set KEY VALUE
#
# The pairing code is the only secret here: the stream id and the push token
# are derived from it, so anything that can read this file can push telemetry
# to your device. Set it with:  sudo peekesp pair YOUR-CODE
PEEK_PAIR_CODE=

# Seconds between pushes. Each agent costs 86400/interval requests a day
# against Cloudflare's free 100,000.
PEEK_INTERVAL=5

# A different Worker, if you deployed your own.
PEEK_RELAY_BASE=https://peek-relay-b9a8.onrender.com

# Also answer on :6595, for a device polling over the same LAN. Off by
# default: an open port is not something pushing telemetry should imply.
PEEK_SERVE=0

# Extra sensors (GPU, NPU, fans), alert rules, and messages for the phone. All
# on unless set to 0, so none of these lines is needed. Rules, quiet hours and
# your own sensors live in /etc/peekesp/alerts.json: see `peekesp rules`,
# `peekesp quiet`, `peekesp hook` and `peekesp sensors`.
#PEEK_ALERTS=1
#PEEK_SENSORS=1
#PEEK_NOTIFY=1
#PEEK_NOTIFY_PORT=6598
#PEEK_MESSAGE_TTL_HOURS=6
#PEEK_EXTRAS_INTERVAL=10
CONF

  install -Dm644 LICENSE      "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 dietpi/README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 dietpi/NOTIFY.md "${pkgdir}/usr/share/doc/${pkgname}/NOTIFY.md"
}

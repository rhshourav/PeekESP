@@ -798,6 +803,21 @@
   sweep(g_bar, bar_anim_cb, g_bar_shown, target);
 }
 
+// A degraded array is the one storage fact worth interrupting someone for, so it
+// overrides the cyan-to-magenta bar instead of sitting politely beside it. Solid
+// red needs the gradient end changed too: the bar fades to magenta, and setting
+// only the start colour would leave a red-to-pink bar that reads as "busy", not
+// "broken". Called after bar_set(), and restores the gradient when it clears, so
+// a host that stops reporting the fault goes back to looking normal.
+static void storage_alarm(bool degraded) {
+  if (degraded) {
+    lv_obj_set_style_bg_color(g_bar, COL_RED, LV_PART_INDICATOR);
+    lv_obj_set_style_bg_grad_color(g_bar, COL_RED, LV_PART_INDICATOR);
+  } else {
+    lv_obj_set_style_bg_grad_color(g_bar, COL_MAGENTA, LV_PART_INDICATOR);
+  }
+}
+
 // ---------------------------------------------------------------------------

#!/bin/sh
#
# peekesp - control the PeekESP telemetry agent.
#
#   peekesp status              is it running, and is it actually pushing
#   peekesp start | stop | restart
#   peekesp enable | disable    start at boot, or not
#   peekesp logs [-f] [-n N]
#   peekesp test                one reading, as this machine would report it
#   peekesp pair CODE           re-pair to a different device
#   peekesp config              current settings
#   peekesp set KEY VALUE       interval | relay | serve
#   peekesp cmd VERB [N]        tell the display: reboot, standby, wake,
#                               refresh, identify, page N, bright N
#   peekesp notify ...          leave a message for your phone
#   peekesp rules | quiet | hook | sensors | alerts
#                               alert rules, quiet hours, extra sensors
#   peekesp check               is a newer release out
#   peekesp update              fetch the latest agent and restart
#   peekesp repair              re-apply the service settings, no download
#   peekesp uninstall
#   peekesp version
#
# Installed by dietpi/install.sh. Everything that changes state needs root,
# and says so rather than failing halfway through.
#
set -eu

RAW_BASE="https://raw.githubusercontent.com/rhshourav/PeekESP/main"
# Two layouts, one script. The curl installer puts the agent in /opt because
# that is what /opt is for - software installed outside the distribution's
# package manager. A distribution package cannot use /opt and must use
# /usr/lib. Checking for the packaged path first means the same peekesp works
# whichever way it arrived, and a machine that has both prefers the managed one.
if [ -f /usr/lib/peekesp/peek-agent.py ]; then
    PREFIX="/usr/lib/peekesp"
else
    PREFIX="/opt/peekesp"
fi
CONF_DIR="/etc/peekesp"
CONF="$CONF_DIR/agent.conf"
UNIT="/etc/systemd/system/peek-agent.service"
SVC="peek-agent.service"
SVC_USER="peekesp"
AGENT="$PREFIX/peek-agent.py"
SELF="/usr/local/bin/peekesp"
STATE_DIR="/var/lib/peekesp"
ALERTS="$CONF_DIR/alerts.json"
DROPIN_DIR="/etc/systemd/system/peek-agent.service.d"

say()  { printf '%s\n' "$*"; }
# The new features are on unless switched off, so unset reads as on.
flag() { case "${1:-}" in 0|off|no|false) echo off ;; *) echo on ;; esac; }
die()  { printf 'error: %s\n' "$*" >&2; exit 1; }

need_root() {
    [ "$(id -u)" = "0" ] || die "'peekesp $1' needs root:  sudo peekesp $*"
}

installed() {
    [ -f "$AGENT" ] || die "PeekESP is not installed here.
       curl -fsSL $RAW_BASE/dietpi/install.sh | sudo sh"
}

# The config is root-only on purpose: the pairing code in it is the credential.
load_conf() {
    [ -r "$CONF" ] || die "cannot read $CONF - run this with sudo"
    # shellcheck disable=SC1090
    . "$CONF"
}

conf_set() {
    # Rewritten through a temp file beside the original so the 0600 root-only
    # mode is inherited rather than recreated, and a failed write cannot leave
    # a half-written credential file behind.
    _key=$1; _val=$2
    umask 077
    _tmp="$CONF.new"
    if [ -f "$CONF" ]; then
        grep -v "^${_key}=" "$CONF" > "$_tmp" || true
    else
        : > "$_tmp"
    fi
    printf '%s=%s\n' "$_key" "$_val" >> "$_tmp"
    mv "$_tmp" "$CONF"
    chmod 0600 "$CONF"
    chown root:root "$CONF" 2>/dev/null || true
}

# The agent now keeps an outbox, a history and a key, and a unit written before
# that has a read-only /var and nowhere to put them. This adds the one setting
# that fixes it, as a drop-in rather than an edit, so it works the same on a
# unit this installer wrote and on one a package shipped, and an update of
# either leaves it alone. It also lets the service read alerts.json: the config
# directory becomes group-readable, but agent.conf - the credential - stays 0600.
repair_install() {
    if command -v systemctl >/dev/null 2>&1; then
        if ! systemctl cat "$SVC" 2>/dev/null | grep -q '^StateDirectory='; then
            mkdir -p "$DROPIN_DIR"
            printf '[Service]\nStateDirectory=peekesp\nStateDirectoryMode=0750\n' \
                > "$DROPIN_DIR/state.conf"
            chmod 0644 "$DROPIN_DIR/state.conf"
            systemctl daemon-reload 2>/dev/null || true
            say "gave the service a state directory ($STATE_DIR)"
        fi
    fi
    if [ -d "$CONF_DIR" ] && getent group "$SVC_USER" >/dev/null 2>&1; then
        chgrp "$SVC_USER" "$CONF_DIR" 2>/dev/null && chmod 0750 "$CONF_DIR" || true
        # The credential stays root-only whatever the directory allows.
        if [ -f "$CONF" ]; then
            chmod 0600 "$CONF" 2>/dev/null || true
            chown root:root "$CONF" 2>/dev/null || true
        fi
        if [ -f "$ALERTS" ]; then
            chgrp "$SVC_USER" "$ALERTS" 2>/dev/null && chmod 0640 "$ALERTS" || true
        fi
    fi
    return 0
}

restart_if_running() {
    if systemctl is-enabled --quiet "$SVC" 2>/dev/null \
       || systemctl is-active --quiet "$SVC" 2>/dev/null; then
        systemctl restart "$SVC"
        say "restarted"
    fi
}

usage() {
    # Written out rather than sed'd out of this file's own header: a script
    # that prints its help by line number goes wrong the first time someone
    # adds a comment above it, and does so silently.
    cat <<'EOF'
peekesp - control the PeekESP telemetry agent

  peekesp status              is it running, and is it actually pushing
  peekesp start|stop|restart  service control
  peekesp enable|disable      start at boot, or not
  peekesp logs [-f] [-n N]    journal for the agent
  peekesp test                one reading, as this machine would report it

  sudo peekesp pair CODE      re-pair to a different device
  peekesp config              current settings
  sudo peekesp set KEY VALUE  interval SECONDS | relay URL | serve on|off |
                              alerts on|off | sensors on|off | notify on|off |
                              notify-port N | ttl HOURS | extras-interval SECONDS
  sudo peekesp cmd VERB [N]   tell the display: reboot | standby | wake |
                              refresh | identify | page N | bright 0-3
  peekesp check               is a newer release out
  sudo peekesp update         fetch the latest agent and restart
  sudo peekesp repair         re-apply the service settings, no download
  sudo peekesp uninstall      remove the service, the files and the account
  peekesp version

Messages, rules and sensors:

  peekesp notify --severity red --title "..." [--message "..."]
                              put a message in front of your phone. Any
                              member of the peekesp group may; no sudo
  peekesp rules               the alert rules that run on this machine
  sudo peekesp rules add METRIC above|below|unusual LIMIT [--for SECONDS]
                              [--severity S] | on ID | off ID | rm ID | reset
  peekesp quiet               quiet hours for the hook
  sudo peekesp quiet 22:00 07:00 [--days weekdays] | off
  peekesp hook                a command run for every new message
  sudo peekesp hook set [--min warning] /path/to/program [args] | off
  peekesp sensors             what is being read now: GPU, NPU, fans, your own
  sudo peekesp sensors add KEY file|command|http TARGET | rm KEY | test KEY
  peekesp alerts              a summary; `alerts edit` opens the file

Anything that changes state needs root. The pairing code is the credential,
so reading the config does too.
EOF
}


cmd=${1:-status}
[ $# -gt 0 ] && shift || true

case "$cmd" in

status)
    installed
    if systemctl is-active --quiet "$SVC"; then
        say "service   running"
    else
        say "service   stopped"
    fi
    if systemctl is-enabled --quiet "$SVC" 2>/dev/null; then
        say "at boot   enabled"
    else
        say "at boot   disabled"
    fi

    if [ -r "$CONF" ]; then
        # shellcheck disable=SC1090
        . "$CONF"
        say "machine   $(hostname)"
        say "interval  ${PEEK_INTERVAL:-5}s"
        say "relay     ${PEEK_RELAY_BASE:-https://peek-relay-b9a8.onrender.com}"
        if [ -n "${PEEK_PAIR_CODE:-}" ]; then
            say "stream    $(python3 "$AGENT" --pair-code "$PEEK_PAIR_CODE" --verify 2>/dev/null || echo '?')"
        fi
    else
        say "config    (run with sudo to read it)"
    fi

    # "Running" is not the same as "working", and the difference is the whole
    # question. A rejected push leaves the service perfectly active.
    if journalctl -u "$SVC" -n 200 --no-pager 2>/dev/null | grep -q 'push rejected'; then
        say ""
        say "pushes are being REJECTED - usually the wrong pairing code."
        journalctl -u "$SVC" -n 3 --no-pager 2>/dev/null | grep 'push rejected' | tail -1
        say "re-pair with:  sudo peekesp pair NEW-CODE"
    elif journalctl -u "$SVC" -n 200 --no-pager 2>/dev/null | grep -q 'pushing to'; then
        say ""
        say "pushing normally"
    fi

    # What the agent adds beyond the standard reading, and the two ways it can
    # be quietly half-working: a unit with no state directory (messages would
    # not survive a restart and the local endpoint is off), and an unreadable
    # alerts.json (the rules would be the defaults, not yours).
    say ""
    python3 "$AGENT" alerts 2>/dev/null | sed 's/^/  /' || true
    if journalctl -u "$SVC" -n 200 --no-pager 2>/dev/null | grep -q 'no writable state directory'; then
        say "  messages  NOT persisted, and the local endpoint is off"
        say "            fix with:  sudo peekesp repair"
    fi
    ;;

start|stop|restart)
    installed
    need_root "$cmd"
    systemctl "$cmd" "$SVC"
    say "$cmd ok"
    ;;

enable|disable)
    installed
    need_root "$cmd"
    if [ "$cmd" = "enable" ]; then
        systemctl enable --now "$SVC"
        say "enabled and started"
    else
        systemctl disable --now "$SVC"
        say "disabled and stopped"
    fi
    ;;

logs)
    installed
    journalctl -u "$SVC" --no-pager "$@" 2>/dev/null \
        || die "no journal for $SVC yet"
    ;;

test)
    installed
    # Reads /proc and /sys and pushes nothing, so this is safe at any time and
    # answers "is the agent reading this machine correctly" separately from
    # "is it reaching the relay".
    say "reading this machine (about 2 seconds) ..."
    python3 "$AGENT" --once
    ;;

pair)
    installed
    need_root pair "$@"
    [ $# -ge 1 ] || die "usage: sudo peekesp pair K7M2-P4QX-9R"
    stream=$(python3 "$AGENT" --pair-code "$1" --verify) \
        || die "that does not look like a pairing code.
       Ten characters, dashes and case optional, as shown on the device."
    conf_set PEEK_PAIR_CODE "$1"
    say "paired to stream $stream"
    restart_if_running
    ;;

config)
    installed
    load_conf
    say "pair code   ${PEEK_PAIR_CODE:-(unset)}"
    say "relay       ${PEEK_RELAY_BASE:-https://peek-relay-b9a8.onrender.com}"
    say "interval    ${PEEK_INTERVAL:-5}s"
    say "serve       $([ "${PEEK_SERVE:-0}" = "1" ] && echo 'yes, on :6595' || echo no)"
    say "alerts      $(flag "${PEEK_ALERTS:-}")    sensors $(flag "${PEEK_SENSORS:-}") every ${PEEK_EXTRAS_INTERVAL:-10}s"
    say "messages    kept ${PEEK_MESSAGE_TTL_HOURS:-6}h; local endpoint $(flag "${PEEK_NOTIFY:-}") (127.0.0.1:${PEEK_NOTIFY_PORT:-6598})"
    say ""
    say "file        $CONF"
    say "rules       $ALERTS"
    say "state       $STATE_DIR"
    say "agent       $AGENT"
    ;;

set)
    installed
    need_root set "$@"
    [ $# -ge 2 ] || die "usage: sudo peekesp set KEY VALUE
       interval SECONDS   how often to push (5 is the default)
       relay    URL       a different Worker
       serve    on|off    also answer on :6595, for a device on the same LAN
       alerts   on|off    run the alert rules on this machine
       sensors  on|off    report GPU, NPU, fans and disk temperature
       notify   on|off    the 127.0.0.1 endpoint other programs can POST to
       notify-port N      its port (6598)
       ttl HOURS          how long a message stays in every reading (6)
       extras-interval S  seconds between sensor reads (10)"
    case "$1" in
        interval)
            case "$2" in
                ''|*[!0-9.]*) die "interval must be a number of seconds" ;;
            esac
            conf_set PEEK_INTERVAL "$2"
            say "interval $2s"
            say "(each agent costs 86400/$2 requests a day against Cloudflare's"
            say " free 100,000 - raising this is how you fit more machines)"
            ;;
        relay)
            case "$2" in
                https://*) ;;
                *) die "the relay must be an https:// URL" ;;
            esac
            conf_set PEEK_RELAY_BASE "$2"
            say "relay $2"
            ;;
        serve)
            case "$2" in
                on|yes|1|true)  conf_set PEEK_SERVE 1; say "serving on :6595 as well" ;;
                off|no|0|false) conf_set PEEK_SERVE 0; say "pushing only" ;;
                *) die "serve is on or off" ;;
            esac
            ;;
        alerts|sensors|notify)
            _var=PEEK_$(printf '%s' "$1" | tr 'a-z' 'A-Z')
            case "$2" in
                on|yes|1|true)  conf_set "$_var" 1; say "$1 on" ;;
                off|no|0|false) conf_set "$_var" 0; say "$1 off" ;;
                *) die "$1 is on or off" ;;
            esac
            ;;
        notify-port)
            case "$2" in
                ''|*[!0-9]*) die "the port must be a number" ;;
            esac
            [ "$2" -ge 1024 ] && [ "$2" -le 65535 ] || die "the port must be 1024-65535"
            conf_set PEEK_NOTIFY_PORT "$2"
            say "local endpoint on 127.0.0.1:$2"
            ;;
        ttl)
            case "$2" in
                ''|*[!0-9]*) die "ttl is a whole number of hours, 1-72" ;;
            esac
            [ "$2" -ge 1 ] && [ "$2" -le 72 ] || die "ttl is 1-72 hours"
            conf_set PEEK_MESSAGE_TTL_HOURS "$2"
            say "messages stay in every reading for $2 hours"
            ;;
        extras-interval)
            case "$2" in
                ''|*[!0-9]*) die "extras-interval is a whole number of seconds, 2-600" ;;
            esac
            [ "$2" -ge 2 ] && [ "$2" -le 600 ] || die "extras-interval is 2-600 seconds"
            conf_set PEEK_EXTRAS_INTERVAL "$2"
            say "sensors are read every ${2}s"
            ;;
        *)
            die "unknown setting '$1' - try interval, relay, serve, alerts, sensors, notify, notify-port, ttl or extras-interval"
            ;;
    esac
    restart_if_running
    ;;

update)
    installed
    need_root update
    # Same reasoning as uninstall. Downloading over a dpkg- or pacman-managed
    # file leaves the package manager's records describing a file that is no
    # longer there, and the copy of this script would land in /usr/local/bin,
    # which shadows the packaged /usr/bin/peekesp on PATH from then on - so the
    # machine would be running an unmanaged agent while apt still believed it
    # owned one.
    if [ "$PREFIX" = "/usr/lib/peekesp" ]; then
        die "this copy was installed by your package manager.
       Update it with that instead:  sudo pacman -Syu peekesp
                                     sudo apt update && sudo apt install --only-upgrade peekesp"
    fi
    say "fetching the latest agent ..."
    tmp="$PREFIX/.peek-agent.py.new"
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL --proto '=https' --tlsv1.2 "$RAW_BASE/dietpi/peek-agent.py" -o "$tmp"
    else
        wget -q --https-only -O "$tmp" "$RAW_BASE/dietpi/peek-agent.py"
    fi
    # Checked before it replaces anything: a truncated download that parses as
    # nothing would otherwise take the service down until the next release.
    python3 -c "import ast,sys; ast.parse(open(sys.argv[1]).read())" "$tmp" \
        || { rm -f "$tmp"; die "the download is not valid Python - nothing was changed"; }
    mv "$tmp" "$AGENT"
    chmod 0755 "$AGENT"

    if command -v curl >/dev/null 2>&1; then
        curl -fsSL --proto '=https' --tlsv1.2 "$RAW_BASE/dietpi/peekesp" -o "$SELF.new"
    else
        wget -q --https-only -O "$SELF.new" "$RAW_BASE/dietpi/peekesp"
    fi
    sh -n "$SELF.new" && mv "$SELF.new" "$SELF" && chmod 0755 "$SELF" \
        || { rm -f "$SELF.new"; say "(kept the existing peekesp command)"; }

    # A new agent may need the service set up differently than the one it
    # replaces. Done here so `peekesp update` is the whole upgrade.
    repair_install
    say "updated"
    restart_if_running
    ;;

repair)
    installed
    need_root repair
    # No download. For a unit or config directory written before the agent kept
    # any state, and for a packaged install whose unit this installer never saw.
    repair_install
    say "ok"
    restart_if_running
    ;;

uninstall)
    need_root uninstall
    if [ "$PREFIX" = "/usr/lib/peekesp" ]; then
        die "this copy was installed by your package manager.
       Remove it with that instead:  sudo pacman -R peekesp
                                     sudo apt remove peekesp"
    fi
    systemctl disable --now "$SVC" 2>/dev/null || true
    rm -f "$UNIT"
    rm -rf "$DROPIN_DIR"
    systemctl daemon-reload 2>/dev/null || true
    rm -rf "$PREFIX" "$CONF_DIR" "$STATE_DIR"
    userdel "$SVC_USER" 2>/dev/null || true
    rm -f "$SELF"
    say "Removed. The relay keeps this machine's last reading for 24 hours,"
    say "then drops it from the device on its own."
    ;;

cmd|command)
    installed
    # Usage before the root check, so `peekesp cmd` on its own explains itself
    # rather than asking for sudo first.
    [ $# -ge 1 ] || die "usage: sudo peekesp cmd VERB [N]
       reboot     restart the display; it keeps its settings
       standby    screen off, polling slowed to once a minute
       wake       screen back on
       refresh    poll now instead of waiting out the interval
       identify   flash the screen, to find which display this is
       page N     jump to page N: the machines, then the clock, then power
       bright N   backlight 0-3, for 100 / 59 / 27 / 8 %"
    # Root, because the pairing code is the credential and the file holding it
    # is 0600. The command is then authorised with the push token derived from
    # that code - the one this machine already pushes with - so it grants
    # nothing this machine did not already have.
    need_root cmd "$@"
    load_conf
    [ -n "${PEEK_PAIR_CODE:-}" ] || die "no pairing code in $CONF - set one with:
       sudo peekesp pair YOUR-CODE"
    python3 "$AGENT" --pair-code "$PEEK_PAIR_CODE" \
        --relay-base "${PEEK_RELAY_BASE:-https://peek-relay-b9a8.onrender.com}" \
        --command "$@"
    ;;

notify|rules|quiet|hook|sensors)
    installed
    # The agent does the work, so the rules for what is valid live in one place.
    # Reading needs read access to alerts.json (root, or the service group);
    # writing needs root. The agent says which when it cannot.
    exec python3 "$AGENT" "$cmd" "$@"
    ;;

alerts)
    installed
    if [ "${1:-}" = "edit" ]; then
        need_root alerts edit
        # Start from the defaults if there is no file, so there is something to
        # change; check afterwards, so a typo is found now and not at 3 a.m.
        python3 "$AGENT" alerts init
        ${VISUAL:-${EDITOR:-$(command -v nano || command -v vi)}} "$ALERTS"
        if python3 "$AGENT" alerts check; then
            say "the agent picks this up within 5 seconds"
        else
            say "fix the problems above and run  sudo peekesp alerts edit  again"
            exit 1
        fi
    else
        exec python3 "$AGENT" alerts "$@"
    fi
    ;;

check)
    installed
    # Read-only and needs no root: it asks GitHub for the newest release and
    # compares it with the installed agent. The exit status carries the answer
    # - 0 up to date, 10 newer available, 1 could not check - so a cron job or
    # a monitoring check can act on it without parsing the sentence.
    set +e
    python3 "$AGENT" --check-update
    rc=$?
    set -e
    if [ "$rc" -eq 10 ]; then
        if [ "$PREFIX" = "/usr/lib/peekesp" ]; then
            say "update it with your package manager:"
            say "    sudo apt update && sudo apt install --only-upgrade peekesp"
            say "    sudo pacman -Syu peekesp"
        else
            say "update it with:  sudo peekesp update"
        fi
    fi
    exit "$rc"
    ;;

version)
    if [ -f "$AGENT" ]; then
        # An agent older than --version answers with a usage error. "unknown"
        # is the honest reading of that, and it must not fail the command: the
        # release pipeline runs this to prove a fresh install works.
        say "agent     $(python3 "$AGENT" --version 2>/dev/null || echo unknown)"
        say "path      $AGENT"
        say "modified  $(date -r "$AGENT" '+%Y-%m-%d %H:%M' 2>/dev/null || echo unknown)"
    else
        say "not installed"
    fi
    say "source    https://github.com/rhshourav/PeekESP"
    ;;

help|-h|--help)
    usage
    ;;

*)
    say "unknown command '$cmd'"
    say ""
    usage
    exit 2
    ;;
esac
